
@model IReadOnlyList<Anbarak.Contracts.DTOs.Products.ProductDto>

@{
    ViewData["Title"] = "Products";
    var includeInactive =
        ViewBag.IncludeInactive is bool value && value;
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Inventory / Catalog</div>
        <h1 class="page-title">Product catalog</h1>
        <p class="page-subtitle">
            Manage your products, review their status, and maintain
            your warehouse catalog.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary px-4 py-2">
        <span class="me-1">+</span> Add product
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm"
         role="status">
        @successMessage
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<div class="content-card mb-4">
    <div class="content-card-header">
        <div>
            <h2 class="section-title">All products</h2>
            <p class="section-description">
                @Model.Count product(s) in this view
            </p>
        </div>

        <form asp-action="Index"
              method="get"
              class="d-flex flex-wrap align-items-center gap-3">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="includeInactive"
                       name="includeInactive"
                       value="true"
                       checked="@(includeInactive ? "checked" : null)" />

                <label class="form-check-label small"
                       for="includeInactive">
                    Show inactive
                </label>
            </div>

            <button type="submit"
                    class="btn btn-outline-secondary btn-sm">
                Apply filter
            </button>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-mark">P</div>
            <h3 class="h5 fw-bold">No products found</h3>
            <p class="text-secondary mb-4">
                Create your first product to begin building your catalog.
            </p>
            <a asp-action="Create" class="btn btn-primary">
                Create your first product
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover product-table">
                <thead>
                    <tr>
                        <th scope="col">SKU</th>
                        <th scope="col">Product</th>
                        <th scope="col">Unit</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created </th>
                        <th scope="col">Modified </th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <span class="product-sku">@product.Sku</span>
                        </td>

                        <td>
                            <div class="product-name">@product.Name</div>
                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <div class="product-description"
                                     title="@product.Description">
                                    @product.Description
                                </div>
                            }
                        </td>

                        <td>
                            <span class="text-secondary">
                                @product.UnitOfMeasure
                            </span>
                        </td>

                        <td>
                            @if (product.IsActive)
                            {
                                <span class="status-badge status-active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td class="text-secondary small text-nowrap">
                                @product.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </td>

                        <td class="text-secondary small text-nowrap">
                                @product.LastModified.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </td>

                        <td>
                            <div class="action-group justify-content-end">
                                <a asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                @if (product.IsActive)
                                {
                                    <form asp-action="Deactivate"
                                          asp-route-id="@product.Id"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Deactivate
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate"
                                          asp-route-id="@product.Id"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Activate
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
