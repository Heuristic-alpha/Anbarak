<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>Anbarak - @ViewData["Title"]</title>
</head>
<body>
    <header>
        <nav>
            <a asp-controller="Home" asp-action="Index">
                Anbarak
            </a>
            <partial name="_LoginPartial" />
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year - Anbarak</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>